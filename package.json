{
  "name": "studex",
  "private": true,
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @studex/app start",
    "web": "pnpm --filter @studex/app web",
    "ios": "pnpm --filter @studex/app ios",
    "android": "pnpm --filter @studex/app android",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json}\" \"packages/**/*.{ts,tsx,json}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,json,md}\"",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "eslint": "~9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "~3.10.1",
    "supabase": "2.84.2",
    "turbo": "2.11.11",
    "typescript-eslint": "~8.72.2"
  }
}
